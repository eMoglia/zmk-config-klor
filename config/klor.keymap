
//                               █         █    █            ▄▄▄▀▀▀▀▀▀▄▄▄        █▀▀▀▀▀▀▀▀▀▀█
//                               █        █     █          ▄▀            ▀▄      █          █
//                               █       █      █        ▄▀                ▀▄    █          █
//                               █      █       █        █                  █    █          █
//                               █     █        █       █                    █   █          █
//                               █    █         █       █                    █   █▄▄▄▄▄▄▄▄▄▄█
//                               █   █ █        █       █                    █   █      █
//                               █  █   █       █        █                  █    █       █
//                               █ █     █      █        ▀▄                ▄▀    █        █
//                               ██       █     █          ▀▄            ▄▀      █         █
//                               █         █    █▄▄▄▄▄▄▄▄    ▀▀▀▄▄▄▄▄▄▀▀▀        █          █
//

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>


#define BASE   0
#define NAV    1
#define FN     2


/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
/*           ┌─────────┬─────────┬─────────┬─────────┬─────────┐                    ┌─────────┬─────────┬─────────┬─────────┬─────────┐
             │    Q    │    C    │    O    │    P    │    W    │                    │    J    │    M    │    D    │    ★    │    Y    │
   ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤                    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
   │   ESC   │    A    │    S    │    E    │ N/SHIFT │    F    │                    │    L    │ R/SHIFT │    T    │    I    │    U    │   RET   │
   ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤╭────────╮╭────────╮├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
   │   FN    │    Z    │    X    │    -    │    V    │    B    ││  MUTE  ││ P/PSE  ││    .    │    H    │    G    │    ,    │    K    │  RSHFT  │
   └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┼╰────────╯╰────────╯┼─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                 │   DEL   │   ALT   │  LCTRL  │   WIN   ││   NAV   │  SPACE  │  ALTGR  │  BSPCE  │
                                 └─────────┴─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┴─────────┘ */
            bindings = <
                       &kp Q     &kp W     &kp E     &kp R         &kp T                                          &kp Y    &kp U         &kp I      &kp O     &kp P
            &kp ESC    &kp A     &kp S     &kp D     &hm RSHFT F   &kp G                                          &kp H    &hm RSHFT J   &kp K      &kp L     &kp SEMI   &kp RET
            &mo FN     &kp Z     &kp X     &kp C     &kp V         &kp B     &kp C_MUTE     &kp C_PLAY_PAUSE      &kp N    &kp M         &kp COMMA  &kp DOT   &kp FSLH   &kp RSHFT
                                           &kp DEL   &kp LALT      &kp LCTRL &kp LGUI             &mo NAV         &kp SPACE &kp RALT     &kp BSPC
            >;
            /* Les autres couches n'ont pas de sensor-bindings : elles héritent de ceux-ci. */
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PAGE_DOWN PAGE_UP>;
        };

        nav_layer {
            display-name = "NAV";
/*           ┌─────────┬─────────┬─────────┬─────────┬─────────┐                    ┌─────────┬─────────┬─────────┬─────────┬─────────┐
             │   TAB   │   HOME  │    UP   │   END   │   P UP  │                    │    /    │    7    │    8    │    9    │  NMLCK  │
   ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤                    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
   │         │  LSHFT  │   LEFT  │  DOWN   │  RIGHT  │ P DOWN  │                    │    -    │    4    │    5    │    6    │    0    │         │
   ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤╭────────╮╭────────╮├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
   │         │  CPLCK  │   VOL-  │         │  VOL+   │         ││        ││        ││    +    │    1    │    2    │    3    │         │         │
   └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┼╰────────╯╰────────╯┼─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                 │         │         │         │         ││         │    *    │    .    │    ,    │
                                 └─────────┴─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┴─────────┘ */
            bindings = <
                       &kp TAB    &kp HOME           &kp UP      &kp END           &kp PG_UP                      &kp KP_DIVIDE   &kp KP_N7   &kp KP_N8   &kp KP_N9   &kp KP_NUMLOCK
            &trans     &kp LSHFT  &kp LEFT           &kp DOWN    &kp RIGHT         &kp PG_DN                      &kp KP_MINUS    &kp KP_N4   &kp KP_N5   &kp KP_N6   &kp KP_N0        &trans
            &trans     &kp CAPS   &kp C_VOLUME_DOWN  &trans      &kp C_VOLUME_UP   &trans            &trans &trans &kp KP_PLUS    &kp KP_N1   &kp KP_N2   &kp KP_N3   &trans           &trans
                                                     &trans      &trans            &trans            &trans &trans &kp KP_MULTIPLY &kp KP_DOT &kp KP_COMMA
            >;
        };

        fn_layer {
            display-name = "FN";
/*           ┌─────────┬─────────┬─────────┬─────────┬─────────┐                    ┌─────────┬─────────┬─────────┬─────────┬─────────┐
             │         │         │         │         │ EXT PWR │                    │         │   F7    │   F8    │   F9    │   F12   │
   ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤                    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
   │         │ BT_NXT  │         │         │         │         │                    │         │   F4    │   F5    │   F6    │   F11   │         │
   ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤╭────────╮╭────────╮├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
   │         │ BT_PRV  │         │         │         │ BT_CLR  ││        ││        ││         │   F1    │   F2    │   F3    │   F10   │         │
   └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┼╰────────╯╰────────╯┼─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                 │         │         │         │         ││         │         │         │         │
                                 └─────────┴─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┴─────────┘ */
            bindings = <
                       &trans     &trans     &trans     &trans     &ext_power EP_TOG                              &trans    &kp F7    &kp F8    &kp F9    &kp F12
            &trans     &bt BT_NXT &trans     &trans     &trans     &trans                                         &trans    &kp F4    &kp F5    &kp F6    &kp F11    &trans
            &trans     &bt BT_PRV &trans     &trans     &trans     &bt BT_CLR &trans              &trans          &trans    &kp F1    &kp F2    &kp F3    &kp F10    &trans
                                             &trans     &trans     &trans     &trans              &trans          &trans    &trans    &trans
            >;
        };

        /* Emplacements réservés pour ZMK Studio : à garder en dernier. */
        extra1 {
            status = "reserved";
        };

        extra2 {
            status = "reserved";
        };
    };
};
